.DS_Store
.Rhistory
.RData
aDNA.code-workspace
__pycache__
.snakemake/
*.bkp

# pastForward CLI (workflow/scripts/cli/): .pastforward/ holds the tracked-run state file,
# logs/ holds timestamped run/dryrun logs - both per project root.
.pastforward/
/logs/

# Synthetic test library materialized by tests/build_test_library.py (rebuilt on every
# test run - see tests/README.md).
tests/fixtures/

# A project's own config/config.yaml is the user's, never the repo's. The pattern has no
# leading slash, so it matches at any depth. The shipped workflow profile is named profile.yaml
# so this pattern does not swallow it.
config.yaml
# Tier-1 test project (.test/): its config is part of the repo, its run outputs are not.
!.test/config/config.yaml
.test/logs/
.test/Dmel/processed/
.test/Dmel/results/
# Tier-2 test project (.test/full/): only its config is tracked, the downloaded data and outputs are not.
.test/full/*
!.test/full/config/
!.test/full/config/config.yaml
