# Synthetic test library materialized by tests/build_test_library.py (rebuilt on every
# test run - see tests/README.md).
tests/fixtures/

# A project's own config/config.yaml is the user's, never the repo's. The pattern has no
# leading slash, so it matches at any depth. The shipped workflow profile is named profile.yaml
# so this pattern does not swallow it.
config.yaml